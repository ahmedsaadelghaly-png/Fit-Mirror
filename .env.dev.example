# ---------------------------------------------------------------------------
# FitMirror AI — DEVELOPMENT environment template.
# Copy to `.env` for local Docker Compose development:
#   cp .env.dev.example .env
# Matches the default credentials baked into docker-compose.dev.yml.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# --- Postgres ---
POSTGRES_USER=fitmirror
POSTGRES_PASSWORD=fitmirror
POSTGRES_DB=fitmirror
DATABASE_URL=postgresql+psycopg2://fitmirror:fitmirror@localhost:5432/fitmirror

# --- JWT --- (dev-only secret; never reuse in staging/production)
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI Service ---
AI_SERVICE_BASE_URL=http://localhost:8001/
AI_SERVICE_TIMEOUT_SECONDS=180
TRYON_MODEL_NAME=placeholder

# --- Shopping Assistant query understanding (Claude; empty = rule-based) ---
ANTHROPIC_API_KEY=
SHOPPING_LLM_MODEL=claude-opus-5-5
SHOPPING_LLM_TIMEOUT_SECONDS=20

# --- Embeddings (AI Stylist, Shopping Assistant; empty = local hashing) ---
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5-lite

# --- Try-on model routing (see docs/AI_INTERFACES.md) ---
# Weighted A/B split, e.g. "idm-vton=90,placeholder=10" (empty = TRYON_MODEL_NAME only)
TRYON_MODEL_ROUTES=
# Tried in order when the routed model fails or its output is rejected
TRYON_FALLBACK_MODELS=placeholder
# Hosted diffusion try-on ("idm-vton"): Replicate token + pinned model version id
REPLICATE_API_TOKEN=
REPLICATE_TRYON_VERSION=
REPLICATE_TIMEOUT_SECONDS=150

# --- Object Storage (MinIO) ---
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=fitmirror
S3_SECRET_KEY=fitmirror123
S3_BUCKET_NAME=fitmirror-media
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=
# Under Docker Compose, S3_ENDPOINT_URL is overridden to the internal
# "http://minio:9000" (see docker-compose.yml) so backend/AI-service/worker
# can reach MinIO — but that hostname isn't resolvable from a real browser,
# which needs to follow presigned upload URLs directly. Set this so those
# URLs are signed against a host the browser can actually reach.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- CORS --- (wide open for local frontend dev on any port)
CORS_ORIGINS=["*"]

# --- Rate limiting (placeholder — disabled in dev) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Security headers (placeholder — relaxed in dev) ---
SECURE_HEADERS_ENABLED=false

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
# Browser-reachable MinIO origin — must match S3_PUBLIC_ENDPOINT_URL above.
# Widens the frontend's CSP connect-src so the browser can PUT directly to
# a pre-signed upload URL there. Not docker-compose.yml's frontend service
# environment: block already sets this for the containerized frontend;
# this line only matters for non-Docker `npm run dev`.
NEXT_PUBLIC_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
