# ---------------------------------------------------------------------------
# FitMirror AI — environment configuration template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Postgres (used to build DATABASE_URL in docker-compose) ---
POSTGRES_USER=fitmirror
POSTGRES_PASSWORD=fitmirror
POSTGRES_DB=fitmirror

# --- Backend: Database ---
# Local (non-docker) example: postgresql+psycopg2://fitmirror:fitmirror@localhost:5432/fitmirror
DATABASE_URL=postgresql+psycopg2://fitmirror:fitmirror@localhost:5432/fitmirror

# --- Backend: JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Backend: Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Backend: AI Service ---
AI_SERVICE_BASE_URL=http://localhost:8001/
AI_SERVICE_TIMEOUT_SECONDS=30

# --- Object Storage (S3-compatible — works with MinIO locally) ---
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=fitmirror
S3_SECRET_KEY=fitmirror123
S3_BUCKET_NAME=fitmirror-media
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=
# Under Docker Compose, S3_ENDPOINT_URL is overridden to the internal
# "http://minio:9000" (see docker-compose.yml) so backend/AI-service/worker
# can reach MinIO — but that hostname isn't resolvable from a real browser,
# which needs to follow presigned upload URLs directly. Set this so those
# URLs are signed against a host the browser can actually reach.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS=["*"]

# --- AI Service specific ---
TRYON_MODEL_NAME=placeholder

# --- Rate limiting (placeholder — see app/core/middleware.py) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Security headers (placeholder — see app/core/middleware.py) ---
SECURE_HEADERS_ENABLED=false
BCRYPT_ROUNDS=12

# --- Frontend (Next.js) ---
# Only NEXT_PUBLIC_* vars are readable by browser code — see
# frontend/config/env.ts. The Docker Compose `environment:` block
# overrides these for the containerized frontend; this section documents
# them for reference and for non-Docker `npm run dev` (see
# frontend/.env.local.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
# Browser-reachable MinIO/S3 origin — should match S3_PUBLIC_ENDPOINT_URL
# above. Widens the frontend's CSP connect-src so the browser can PUT
# directly to a pre-signed upload URL there.
NEXT_PUBLIC_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- Email (password reset links, contact form) ---
# "log" writes emails to the backend log instead of sending (local dev);
# "smtp" sends through SMTP_HOST.
EMAIL_BACKEND=log
EMAIL_FROM=FitMirror AI <no-reply@fitmirror.ai>
SUPPORT_EMAIL=support@fitmirror.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Where links in emails point (the web app's public URL).
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30
