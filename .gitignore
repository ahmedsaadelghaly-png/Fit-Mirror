# --- Environment / secrets ---
.env
.env.*
!.env.example
!.env.dev.example
!.env.test.example
!.env.production.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.venv

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/

# --- IDE (project-level .vscode is intentionally tracked; ignore local overrides) ---
.vscode/*.local.json
.idea/

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Docker ---
*.pid

# --- Alembic (keep versions/ tracked, ignore local sqlite fallback if ever used) ---
*.sqlite3
