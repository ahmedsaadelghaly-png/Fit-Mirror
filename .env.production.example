# ---------------------------------------------------------------------------
# FitMirror AI — PRODUCTION environment template.
#
# DO NOT copy this file to `.env` and run it as-is. Every CHANGE_ME value
# below must come from a real secrets manager (AWS Secrets Manager, GCP
# Secret Manager, Vault, etc.) at deploy time — never committed, never
# stored in plaintext on a server.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json   # structured JSON logs for production log aggregation

# --- Database --- (use a managed Postgres instance; enable SSL)
DATABASE_URL=postgresql+psycopg2://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/fitmirror?sslmode=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- JWT --- (generate with: openssl rand -hex 64)
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Redis / Celery --- (use a managed Redis instance with auth + TLS)
REDIS_URL=rediss://CHANGE_ME:6380/0
CELERY_BROKER_URL=rediss://CHANGE_ME:6380/1
CELERY_RESULT_BACKEND=rediss://CHANGE_ME:6380/2

# --- AI Service --- (internal network address; never expose publicly)
AI_SERVICE_BASE_URL=http://ai-service.internal:8001/
AI_SERVICE_TIMEOUT_SECONDS=180
TRYON_MODEL_NAME=placeholder

# --- Shopping Assistant query understanding (Claude; empty = rule-based) ---
ANTHROPIC_API_KEY=
SHOPPING_LLM_MODEL=claude-opus-5-5
SHOPPING_LLM_TIMEOUT_SECONDS=20

# --- Embeddings (AI Stylist, Shopping Assistant; empty = local hashing) ---
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5-lite

# --- Try-on model routing (see docs/AI_INTERFACES.md) ---
# Weighted A/B split, e.g. "idm-vton=90,placeholder=10" (empty = TRYON_MODEL_NAME only)
TRYON_MODEL_ROUTES=
# Tried in order when the routed model fails or its output is rejected
TRYON_FALLBACK_MODELS=placeholder
# Hosted diffusion try-on ("idm-vton"): Replicate token + pinned model version id
REPLICATE_API_TOKEN=
REPLICATE_TRYON_VERSION=
REPLICATE_TIMEOUT_SECONDS=150

# --- Object Storage --- (real S3 bucket, restricted IAM credentials)
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=fitmirror-media-prod
S3_REGION=us-east-1
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=https://cdn.fitmirror.ai

# --- CORS --- (explicit allow-list only — never "*" in production)
CORS_ORIGINS=["https://app.fitmirror.ai","https://fitmirror.ai"]

# --- Rate limiting --- (enable and tune before public launch; see
# app/core/rate_limit.py placeholder)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Security headers --- (enable HSTS, X-Frame-Options, etc.; see
# app/core/security_headers.py placeholder)
SECURE_HEADERS_ENABLED=true

# --- Frontend (Next.js) ---
# Must point at the real public API domain — never localhost in production.
NEXT_PUBLIC_API_BASE_URL=https://api.fitmirror.ai/api/v1
NEXT_PUBLIC_APP_ENV=production
