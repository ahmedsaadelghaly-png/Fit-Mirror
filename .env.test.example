# ---------------------------------------------------------------------------
# FitMirror AI — TEST environment template.
# Used by pytest (see tests/conftest.py, which sets the same defaults via
# os.environ.setdefault) and CI (.github/workflows/ci.yml sets these as job
# env directly). Kept here for reference and for running tests manually
# against dockerized test services:
#   cp .env.test.example .env.test && export $(cat .env.test | xargs) && pytest
# ---------------------------------------------------------------------------

ENVIRONMENT=test
DEBUG=false
LOG_LEVEL=WARNING
LOG_FORMAT=text

DATABASE_URL=postgresql+psycopg2://fitmirror:fitmirror@localhost:5432/fitmirror_test

JWT_SECRET_KEY=test-secret-key-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

AI_SERVICE_BASE_URL=http://localhost:8001/
AI_SERVICE_TIMEOUT_SECONDS=10
TRYON_MODEL_NAME=placeholder

STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=fitmirror
S3_SECRET_KEY=fitmirror123
S3_BUCKET_NAME=fitmirror-media-test
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=

CORS_ORIGINS=["*"]

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

SECURE_HEADERS_ENABLED=false
